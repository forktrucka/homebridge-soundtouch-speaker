{
  "name": "homebridge-soundtouchspeaker",
  "displayName": "SoundTouch Speaker",
  "type": "module",
  "version": "0.2.4-beta.2",
  "description": "Updates homebridge-soundtouch-platform to work on latest homebridge.",
  "author": "Andrew Trainor",
  "license": "Apache-2.0",
  "homepage": "https://github.com/forktrucka/homebridge-soundtouch-speaker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forktrucka/homebridge-soundtouch-speaker.git"
  },
  "bugs": {
    "url": "https://github.com/forktrucka/homebridge-soundtouch-speaker/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "bose",
    "soundtouch"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "jest",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/bonjour": "^3.5.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.1",
    "@types/xml2js": "^0.4.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.15.2",
    "homebridge": "^2.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "knip": "^5.50.5",
    "lint-staged": "^15.2.11",
    "nodemon": "^3.1.9",
    "prettier": "3.4.2",
    "rimraf": "^6.1.3",
    "semantic-release": "25.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.2",
    "glob": "^13.0.6",
    "js-yaml": "^4.2.0"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "bonjour": "^3.3.0",
    "homebridge-base-platform": "^1.4.2",
    "homebridge-lib": "^8.1.1",
    "multicast-dns": "^7.2.5",
    "xml2js": "^0.6.2"
  }
